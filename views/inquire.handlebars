<main>
  <section class='section-inquire'>
    <div class='row'>
      <div class='inquire'>

        {{! Header Section }}
        <div class='inquire__header'>
          <h1 class='heading-primary'>Inquire</h1>
          <p class='inquire__sub-text'>
            Tell us about your vision, and let’s craft a coffee experience your
            guests will never forget.
          </p>

          {{! Dynamic Starting Rate Banner (Filters out low-budget leads) }}
          <div class='inquire__rate-badge'>
            <p class='inquire__rate-text'>
              ✨
              {{inquire.RateDisclaimer}}
              <span class='inquire__rate-price'>${{inquire.StartingRate}}</span>
              ({{inquire.MinimumHours}})
            </p>
          </div>
        </div>

        {{! 3-Step Process Flex Grid }}
        <div class='inquire__process-steps'>

          <div class='inquire__step-card'>
            <h3 class='heading-tertiary u-margin-bottom-small'>1. Inquire</h3>
            <p class='paragraph inquire__step-desc'>
              Fill out our instant quote checker below with your event details.
            </p>
          </div>

          <div class='inquire__step-card'>
            <h3 class='heading-tertiary u-margin-bottom-small'>2. Customize</h3>
            <p class='paragraph inquire__step-desc'>
              Select your specialty drinks, custom add-ons, and cart aesthetic.
            </p>
          </div>

          <div class='inquire__step-card'>
            <h3 class='heading-tertiary u-margin-bottom-small'>3. Celebrate</h3>
            <p class='paragraph inquire__step-desc'>
              We show up with our mobile cart, handle the logistics, and serve
              your guests.
            </p>
          </div>

        </div>

        {{! Flashquotes Dynamic Embed Container }}
        <div class='inquire__form-container'>
          <script
            form-id='cmpnginwe0001l704m9chn53y'
            src='https://app.flashquotes.com/embed.js'
          ></script>
        </div>

      </div>
    </div>
  </section>
</main>