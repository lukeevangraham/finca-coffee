<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,700;0,900;1,700&family=Open+Sans:ital,wght@0,400;0,600;1,400&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,700;0,900;1,700&family=Open+Sans:ital,wght@0,400;0,600;1,400&display=swap" media="print" onload="this.media='all'">

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{{#if metaTitle}}{{metaTitle}}{{else}}Finca Coffee | Boutique Mobile Coffee Cart{{/if}}</title>
    <meta name="description" content="{{#if metaDescription}}{{metaDescription}}{{else}}Elevate your Nebraska events with Finca Coffee's boutique mobile espresso bar. Starting at $650.{{/if}}">

    <style>
      /* 1. Freeze the drawer strictly offscreen ONLY while the body is preloading */
      body.preload .SideDrawer {
        position: fixed;
        right: 0;
        top: 0;
        transform: translateX(100%);
        visibility: hidden;
      }
      
      /* 2. Freeze browser layout rendering timelines until JavaScript clears the state */
      body.preload, 
      body.preload * {
        -webkit-transition: none !important;
        -moz-transition: none !important;
        -ms-transition: none !important;
        -o-transition: none !important;
        transition: none !important;
        -webkit-transition-duration: 0s !important;
        transition-duration: 0s !important;
        -webkit-transition-delay: 0s !important;
        transition-delay: 0s !important;
      }
    </style>

    <link rel="preload" href="/assets/css/style.css?v=1.0.1" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="/assets/css/style.css?v=1.0.1"></noscript>

    {{! Dynamic page-specific injections (our preloaded image headers run here) }}
    {{{_sections.head}}}
  </head>
  <body class="preload">

    <section class="header">
      <a href="/" class="header__logo-link" aria-label="Finca Coffee Home">
        <img src="/assets/images/finca-logo-transparent.svg" alt="" class="logo-vector logo-vector--navbar" />
        <span class="logo-text logo-text--navbar">Finca Coffee</span>
      </a>

      <div class="header__drawer-toggle">
        <div></div>
        <div></div>
        <div></div>
      </div>
      <div class="desktop-only">
        {{> nav/nav-items }}
      </div>
    </section>
      
    <div class="Backdrop" id="backdrop"></div>
      
    <div class="SideDrawer" id="side-drawer">
      <div class="SideDrawer__logo">
        <a href="/" class="SideDrawer__logo-link" aria-label="Finca Coffee Home">
          <img src="/assets/images/finca-logo-transparent.svg" alt="" class="SideDrawer__logo-icon" />
          <span class="SideDrawer__logo-text">Finca Coffee</span>
        </a>
      </div>
      <nav>
        {{> nav/nav-items }}
      </nav>
    </div>

    {{{body}}}

    {{> nav/footer }}

    <script src="/assets/js/main.js" defer></script>
  </body>
</html>