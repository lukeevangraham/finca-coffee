<section class='hero'>
  {{! 1. Handle the Image specifically }}
  {{#with mainImage.data.[0].attributes}}
    <img
      src='{{url}}'
      srcset='{{getCloudinaryResize url 640}}, {{getCloudinaryResize
        url
        1200
      }}, {{getCloudinaryResize url 1920}}'
      sizes='100vw'
      alt='{{alternativeText}}'
      class='hero__image'
    />
  {{/with}}

  {{! 2. Handle the Text (Using the correct Strapi keys) }}
  <div class='hero__overlay'>
    <div class='hero__content'>
      <h1 class='hero__headline'>{{headline}}</h1>
      <p class='hero__subheading'>{{subheading}}</p>
      {{!-- Calling the button partial --}}
        {{> UI/button 
            link=Button.[0].url
            text=Button.[0].text
            style="primary" 
            class="btn--animated"
        }}
    </div>
  </div>
</section>


{{#section 'head'}}
  {{#if mainImage.data.[0].attributes}}
    {{#with mainImage.data.[0].attributes}}
      <link 
        rel="preload" 
        as="image" 
        href="{{url}}" 
        imagesrcset="{{getCloudinaryResize url 640}}, {{getCloudinaryResize url 1200}}, {{getCloudinaryResize url 1920}}"
        imagesizes="100vw"
      >
    {{/with}}
  {{/if}}
{{/section}}