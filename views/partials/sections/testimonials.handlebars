<section class='testimonials'>
  <div class='testimonials__container'>

    {{#if Heading}}
      <h2 class='testimonials__main-heading'>{{Heading}}</h2>
    {{/if}}

    <div class='testimonials__grid'>
      {{#each Testimony}}
        <div class='testimonials__card'>
          <div class='testimonials__stars'>
            <span>★★★★★</span>
          </div>

          <blockquote class='testimonials__quote'>
            {{Statement}}
          </blockquote>

          <div class='testimonials__user-box'>
            <div class='testimonials__avatar-box'>
              <img
                {{! Set a small base src, and provide srcset for retina displays }}
                src='{{Photo.data.attributes.url}}'
                srcset='
                    {{getCloudinaryResize Photo.data.attributes.url 100}},
                    {{getCloudinaryResize Photo.data.attributes.url 200}}
                '
                sizes='100px'
                alt='{{FirstName}} {{LastName}}'
                class='testimonials__avatar'
                loading='lazy'
              />
            </div>
            <div class='testimonials__author'>
              <span class='testimonials__author-name'>{{FirstName}}</span>
              <span class='testimonials__author-description'>{{LastName}}</span>
            </div>
          </div>
        </div>
      {{/each}}
    </div>

  </div>
</section>