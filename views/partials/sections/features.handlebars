<section class="section-features">
  {{!-- Section Heading --}}
  <div class="u-center-text u-margin-bottom-big">
    <h2 class="heading-secondary">{{Heading}}</h2>
  </div>

  {{!-- Loop through the features --}}
  {{#each ImageBesideText}}
    <div class="section-features__row">
      
      {{!-- Image Column --}}
      <div class="section-features__image-box">
        {{#if image.data}}
          <img src="{{image.data.attributes.url}}" 
               alt="{{#if image.data.attributes.alternativeText}}{{image.data.attributes.alternativeText}}{{else}}Finca Coffee Feature{{/if}}" 
               class="section-features__img">
        {{/if}}
      </div>

      {{!-- Text Column (Quill HTML) --}}
      <div class="section-features__text-box">
        {{{text}}}
      </div>

    </div>
  {{/each}}
</section>