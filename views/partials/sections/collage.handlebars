<section class='section-gallery'>
  <div class='row-full-width'>

    <div class='gallery-grid'>
      {{#if Images.data}}
        {{#each Images.data}}
          <div class='gallery-grid__item'>
            <img
              src='{{getCloudinaryGallery this.attributes.url 800}}'
              srcset='{{getCloudinaryGallery this.attributes.url 400}} 400w,
          {{getCloudinaryGallery this.attributes.url 800}} 800w,
          {{getCloudinaryGallery this.attributes.url 1200}} 1200w'
              sizes='(max-width: 600px) 50vw, (max-width: 900px) 50vw, 33vw'
              alt='Finca Coffee Event Photo'
              class='gallery-grid__img'
              loading='lazy'
            />
          </div>
        {{/each}}
      {{else}}
        {{! Default Placeholders }}
        <div class='gallery-grid__item'><img
            src='https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=600&q=80'
            alt='Finca Coffee Cart'
            class='gallery-grid__img'
          /></div>
        <div class='gallery-grid__item'><img
            src='https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=600&q=80'
            alt='Specialty Latte'
            class='gallery-grid__img'
          /></div>
        <div class='gallery-grid__item'><img
            src='https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
            alt='Pouring Espresso'
            class='gallery-grid__img'
          /></div>
        <div class='gallery-grid__item'><img
            src='https://images.unsplash.com/photo-1517256064527-09c53b2d0c6f?auto=format&fit=crop&w=600&q=80'
            alt='Mobile Coffee Setup'
            class='gallery-grid__img'
          /></div>
        <div class='gallery-grid__item'><img
            src='https://images.unsplash.com/photo-1570968915860-54d5c301fc9f?auto=format&fit=crop&w=600&q=80'
            alt='Event Hospitality'
            class='gallery-grid__img'
          /></div>
        <div class='gallery-grid__item'><img
            src='https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80'
            alt='Iced Coffee Details'
            class='gallery-grid__img'
          /></div>
      {{/if}}
    </div>

  </div>
</section>